<?xml version="1.0" encoding="utf-8"?> 
<odoo> 

    <!-- Estructura de navegació Superior -->
    <menuitem name="Cinema" id="menu_root"/>

    <menuitem name="Configuration" id="menu_configuration" parent="menu_root" sequence="99"/>
    

    <!-- GESTIÓ DE PERSON -->

    <!-- Vista Llista de Person -->
    <record model="ir.ui.view" id="cinema_person_list">
        <field name="name">cinema.person.list</field>
        <field name="model">cinema.person</field>
        <field name="arch" type="xml">
            <!-- decoration-danger: vermell // decoration-success: verd -->
            <!-- El True no funciona perque si hi ha algo a dins no serà un booleà!!! -->
            <list string="Persons" decoration-danger="death_date != False" decoration-success="death_date == False">
                <field name="full_name" string="Nom complet"></field>
                <field name="gender" string="Gènere"></field>
                <field name="country_id" string="Nacionalitat"></field>
                <field name="birth_date" string="Data Naixement"></field>
                <field name="death_date" string="Data Mort"></field>
                <field name="isDirector" string="Director/a?"></field>
                <field name="isActor" string="Actor/Actriu?"></field>
            </list>
        </field>
    </record>


    <!-- Vista Formulari de Person -->
    <record model="ir.ui.view" id="cinema_person_form">
        <field name="name">cinema.person.form</field>
        <field name="model">cinema.person</field>
        <field name="arch" type="xml">
            <form string="Persona">
                <sheet>

                    <!-- Part de dalt: Dos grups dins d'un grup -->
                    <group>

                        <!-- Esquerra -->
                        <group>
                            <field name="last_name" string="Cognoms"></field> 
                            <field name="first_name" string="Nom"></field>
                            
                            <!-- Grup per a tenir 2 camps en la mateixa linia -->
                            <group colspan="2" col="4">
                                <field name="birth_date" string="Data Naixement"></field>
                                <field name="death_date" string="Data Mort"></field>
                            </group>
                        </group>

                        <!-- Dreta -->
                        <group col="4"> <!-- [Label 1] [Camp 1] [Label 2] [Camp 2] -->
                            <field name="gender" string="Gènere"></field>
                            <field name="country_id" string="Nacionalitat"></field>
                            
                            <field name="isDirector" string="Director/a?"></field>
                            <field name="isActor" string="Actor/Actriu?"></field>
                        </group>

                    </group>

                    <!-- Part de baix: Dos grups dins d'un grup -->
                    <group>

                        <!-- Esquerra -->
                        <group invisible="isDirector == False">
                            <separator string="FILMS DIRIGITS"></separator>
                            <field name="film_directed_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="title" string="Títol"></field>
                                    <field name="duration" string="Durada"></field>
                                    <field name="website" string="Web"></field>
                                </list>
                            </field>
                        </group>

                        <!-- Dreta -->
                        <group invisible="isActor == False">
                            <separator string="FILMS COM ACTOR/ACTRIU"></separator>
                            <field name="film_acting_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="title" string="Títol"></field>
                                    <field name="duration" string="Durada"></field>
                                    <field name="website" string="Web"></field>
                                </list>
                            </field>
                        </group>

                    </group>
                </sheet>
            </form>
        </field>

    </record>


    <!-- Acció de Person -->
    <record model="ir.actions.act_window" id="cinema_person_action">
        <field name="name">Person</field>
        <field name="res_model">cinema.person</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Submenu de Person -->
    <menuitem name="Person" id="menu_persons" parent="menu_configuration" action="cinema_person_action"/>


    <!-- GESTIÓ DE FILM -->

    <!-- Vista Llista de Film -->
    <record model="ir.ui.view" id="cinema_film_list">
        <field name="name">cinema.film.list</field>
        <field name="model">cinema.film</field>
        <field name="arch" type="xml">
            <list string="Films">
                <field name="title" string="Film"></field>
                <field name="year" string="Any"></field>
                <field name="director_id" string="Director/a"></field>
                <field name="duration" string="Durada"></field>
                <field name="film_type" string="Tipus"></field>
                <field name="website" string="Web"></field>
            </list>
        </field>
    </record>


    <!-- Acció de Film -->
    <record model="ir.actions.act_window" id="cinema_film_action">
        <field name="name">Film</field>
        <field name="res_model">cinema.film</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Submenu de Person -->
    <menuitem name="Films" id="menu_films" parent="menu_root" action="cinema_film_action" sequence="10"/>

</odoo> 
