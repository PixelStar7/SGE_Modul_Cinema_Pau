<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Categoria/aplicació per la que definirem els diversos grups/rols -->
        <record id="module_category_cinema" model="ir.module.category">
            <field name="name">Cinema</field>
            <field name="sequence">20</field>
        </record>

        <!-- Definició dels grups/rols que interessi -->

        <record id="group_cinema_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_cinema"/>
        </record>

        <record id="group_cinema_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_cinema"/>
        </record>
    </data>

    <!-- Per assignar el group "manager" a l'usuari "admin" -->
    <function model="res.users" name="write">
        <value eval="[ref('base.user_admin')]"/>
        <value eval="{'groups_id': [(4, ref('cinema_pau.group_cinema_manager'))]}"/>
    </function>

    <!-- Per assignar el group "manager" a l'usuari "OdooBoot" -->
    <function model="res.users" name="write">
        <value eval="[ref('base.user_root')]"/>
        <value eval="{'groups_id': [(4, ref('cinema_pau.group_cinema_manager'))]}"/>
    </function>
</odoo>